<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "program": signs PolyKara's own two programs inside the
     uploaded program folder. Bundled third-party files (ffmpeg, yt-dlp, Python libraries)
     are left as their publishers shipped them. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="PolyKara.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="polykara-cli.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
